.version 6.5
.target sm_30
.address_size 64
.visible .entry legacy_slct(.param .u64 output, .param .s32 selector) {
    .reg .u64 p, q;
    .reg .s32 sign;
    .reg .u16 h;
    .reg .u32 r;
    .reg .f32 f, a, b;
    ld.param.u64 p, [output];
    ld.param.s32 sign, [selector];
    slct.u16.s32 h, 0x1234, 0xfedc, sign;
    cvt.u32.u16 r, h;
    st.global.u32 [p], r;
    slct.u32.s32 r, 0x01234567, 0x89abcdef, sign;
    st.global.u32 [p+4], r;
    slct.u64.s32 q, 0x0123456789abcdef, 0xfedcba9876543210, sign;
    st.global.u64 [p+8], q;
    mov.b32 a, 0x80000000;
    mov.b32 b, 0x7fc01234;
    slct.f32.s32 f, a, b, sign;
    st.global.f32 [p+16], f;
    ret;
}
