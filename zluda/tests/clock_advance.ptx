.version 6.5
.target sm_30
.address_size 64
.visible .entry clock_advance(.param .u64 output) {
 .reg .u64 dst;
 .reg .u32 start, now, elapsed, tries;
 .reg .pred changed, remaining;
 ld.param.u64 dst, [output];
 mov.u32 tries, 100000;
 mov.u32 start, %clock;
again:
 mov.u32 now, %clock;
 sub.u32 elapsed, now, start;
 setp.ne.u32 changed, elapsed, 0;
 @changed bra done;
 sub.u32 tries, tries, 1;
 setp.ne.u32 remaining, tries, 0;
 @remaining bra again;
done:
 st.global.u32 [dst], elapsed;
 ret;
}
