.version 6.5
.target sm_50
.address_size 64

// Minimal GPU test for surface store (sust) operations.
// Reproduces TurbulenceFS crash: kernel writes to a 3D surface via sust,
// which compiles to AMDGPU image_store. Tests that the surface binding
// and image descriptor are correct.

.global .surfref testSurf;

.visible .entry sust_3d_gpu(
    .param .u64 output
)
{
    .reg .u64   out_addr;
    .reg .u64   surf_handle;
    .reg .s32   x, y, z, w;
    .reg .b32   val;

    ld.param.u64    out_addr, [output];

    // Load the surface handle from the global surfref
    // On NVIDIA this is a texture handle; on ZLUDA it's an image descriptor
    mov.u64     surf_handle, testSurf;

    // Write value 42 at coordinates (0,0,0,0) via surface store
    mov.s32     x, 0;
    mov.s32     y, 0;
    mov.s32     z, 0;
    mov.s32     w, 0;
    mov.b32     val, 42;
    sust.b.3d.b32.trap  [surf_handle, {x, y, z, w}], {val};

    // Write a marker to confirm kernel completed without fault
    mov.b32     val, 1;
    st.global.b32   [out_addr], val;
    ret;
}
