.version 6.5
.target sm_50
.address_size 64

// GPU test for the texture-object-used-as-surface-handle bug.
//
// This kernel receives a texture object handle (u64) and extracts the
// pixel shift from it the same way our sust helper does:
//   shift = handle >> 61
// It writes the extracted shift to output[0].
//
// For a FLOAT surface (4 bytes/pixel), the shift should be 2.
// With current bug: texture objects have shift=0 (no encoding).
// After fix: shift should be computed correctly from the descriptor.

.visible .entry check_handle_shift(
    .param .u64 check_handle_shift_param_0,
    .param .u64 check_handle_shift_param_1
)
{
    .reg .u64 %rd<4>;
    .reg .u32 %r<3>;

    // param_0 = surface/texture handle (u64)
    // param_1 = output pointer
    ld.param.u64 %rd1, [check_handle_shift_param_0];
    ld.param.u64 %rd2, [check_handle_shift_param_1];

    // Extract shift from top 3 bits (same as zluda_ptx_impl.cpp x_coordinate_shift)
    shr.u64 %rd3, %rd1, 61;
    cvt.u32.u64 %r1, %rd3;

    // Write shift to output[0]
    st.global.u32 [%rd2], %r1;

    // Write low 32 bits of handle to output[1] for debugging
    cvt.u32.u64 %r2, %rd1;
    st.global.u32 [%rd2+4], %r2;

    ret;
}
