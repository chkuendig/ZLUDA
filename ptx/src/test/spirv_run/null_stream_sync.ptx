.version 4.1
.target sm_50
.address_size 64

// Write a u32 constant to a global memory address
.visible .entry write_val(
    .param .u64 write_val_param_0,
    .param .u32 write_val_param_1
)
{
    .reg .u64 %rd<2>;
    .reg .u32 %r<2>;

    ld.param.u64 %rd1, [write_val_param_0];
    ld.param.u32 %r1, [write_val_param_1];
    st.global.u32 [%rd1], %r1;
    ret;
}

// Copy a u32 from src to dst in global memory
.visible .entry copy_val(
    .param .u64 copy_val_param_0,
    .param .u64 copy_val_param_1
)
{
    .reg .u64 %rd<3>;
    .reg .u32 %r<2>;

    ld.param.u64 %rd1, [copy_val_param_0];
    ld.param.u64 %rd2, [copy_val_param_1];
    ld.global.u32 %r1, [%rd2];
    st.global.u32 [%rd1], %r1;
    ret;
}
