.version 6.5
.target sm_30
.address_size 64

.const .align 4 .b8 params[16];
.const .align 4 .u32 unused_by_kernels;
.global .align 4 .u32 counter;

.visible .entry global_const_uninit(
    .param .u64 output
)
{
    .reg .u64       out_addr;
    .reg .u32       temp;
    .reg .u32       count;

    ld.param.u64    out_addr, [output];
    ld.const.u32    temp, [params+4];
    ld.global.u32   count, [counter];
    add.u32         temp, temp, count;
    st.global.u32   [out_addr], temp;
    ret;
}
