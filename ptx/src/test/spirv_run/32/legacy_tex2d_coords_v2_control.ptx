.version 1.4
.target sm_10
.tex .u32 legacy_texture;

.entry legacy_tex2d_coords_v2_control(.param .u32 output)
{
    .reg .u32 %ptr, %a, %b, %c, %d;
    .reg .f32 %x, %y, %pad_z, %pad_w;
    ld.param.u32 %ptr, [output];
    mov.f32 %x, 0f3f000000;
    mov.f32 %y, 0f3f000000;
    mov.f32 %pad_z, 0f42c80000;
    mov.f32 %pad_w, 0fc2c80000;
    tex.2d.v4.u32.f32 {%a, %b, %c, %d}, [legacy_texture, {%x, %y}];
    st.global.v4.u32 [%ptr], {%a, %b, %c, %d};
    ret;
}
