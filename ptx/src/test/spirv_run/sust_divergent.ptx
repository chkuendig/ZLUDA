.version 6.5
.target sm_50
.address_size 64

// Test: divergent surface writes across lanes in a wavefront.
// Even threads (tid.x % 2 == 0) write 0x42420000 to surface A.
// Odd threads (tid.x % 2 == 1) write 0x43430000 to surface B.
// If CONSTANT_SPACE causes scalar load of the surface descriptor,
// all lanes use the same descriptor (lane 0's = surface A) and
// surface B receives no writes → test fails.

.visible .entry sust_divergent(
    .param .u64 sust_divergent_param_0,
    .param .u64 sust_divergent_param_1,
    .param .u64 sust_divergent_param_2
)
{
    .reg .u64   surf_a, surf_b, chosen_surf;
    .reg .u64   out_addr;
    .reg .s32   tid, is_odd, x, y, z;
    .reg .b32   val;
    .reg .pred  p_odd;

    ld.param.u64    out_addr,  [sust_divergent_param_0];
    ld.param.u64    surf_a,    [sust_divergent_param_1];
    ld.param.u64    surf_b,    [sust_divergent_param_2];

    // Thread ID
    mov.u32     tid, %tid.x;

    // is_odd = tid & 1
    and.b32     is_odd, tid, 1;
    setp.ne.s32 p_odd, is_odd, 0;

    // Select surface handle based on lane parity
    selp.u64    chosen_surf, surf_b, surf_a, p_odd;

    // Coordinates: x = tid (byte-scaled for b32: x *= 4), y = 0, z = 0
    shl.b32     x, tid, 2;
    mov.s32     y, 0;
    mov.s32     z, 0;

    // Value: even lanes write 0x42420000, odd lanes write 0x43430000
    selp.b32    val, 0x43430000, 0x42420000, p_odd;

    // Surface store — divergent handle!
    sust.b.3d.b32.zero [chosen_surf, {x, y, z, z}], {val};

    // Write marker
    mov.b32     val, 1;
    st.global.b32   [out_addr], val;
    ret;
}
