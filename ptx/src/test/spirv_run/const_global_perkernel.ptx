.version 6.5
.target sm_50
.address_size 64

.const .align 8 .b8 gTestParams[64];
.const .align 4 .b8 gTestBounds[16];

.func (.reg .u32 result) helper(.reg .u32 x)
{
    add.u32 result, x, 1;
    ret;
}

.visible .entry kernel_0(.param .u64 out) {
    .reg .u32 tmp;
    call (tmp), helper, (0);
    ret;
}

