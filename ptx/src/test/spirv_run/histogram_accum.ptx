.version 6.5
.target sm_30
.address_size 64

// Test the exact PhysX radix sort packed histogram accumulation.
// Input: 4 keys [0xFFFFFFFF, 0, 1, 2]
// For shift=0, extract digit = (key >> 0) & 0xF:
//   key 0xFFFFFFFF → digit 15, encoded = 15*16 = 240
//   key 0          → digit 0,  encoded = 0
//   key 1          → digit 1,  encoded = 16
//   key 2          → digit 2,  encoded = 32
//
// Then 1 << encoded:
//   digit 0  → 1 << 0   = 1          (word 0, bits 0-15)
//   digit 1  → 1 << 16  = 0x10000    (word 0, bits 16-31)
//   digit 2  → 1 << 32  = 0 (clamped) (word 1 handles this)
//   digit 15 → 1 << 240 = 0 (clamped) (word 7 handles this)
//
// Word 0 accumulator = 1 + 0x10000 + 0 + 0 = 0x00010001
// Output: [0x00010001] (packed: digit0=1, digit1=1)

.visible .entry histogram_accum(
	.param .u64 input,
	.param .u64 output
)
{
	.reg .u64 in_addr, out_addr;
	.reg .u32 %k0, %k1, %k2, %k3;
	.reg .u32 %d0, %d1, %d2, %d3;
	.reg .u32 %s0, %s1, %s2, %s3;
	.reg .u32 %b0, %b1, %b2, %b3;
	.reg .u32 %acc, %one, %shift;

	ld.param.u64 in_addr, [input];
	ld.param.u64 out_addr, [output];

	// Load 4 keys
	ld.u32 %k0, [in_addr];
	ld.u32 %k1, [in_addr+4];
	ld.u32 %k2, [in_addr+8];
	ld.u32 %k3, [in_addr+12];

	// Extract digit: (key >> 0) & 0xF
	mov.u32 %shift, 0;
	shr.u32 %d0, %k0, %shift;
	shr.u32 %d1, %k1, %shift;
	shr.u32 %d2, %k2, %shift;
	shr.u32 %d3, %k3, %shift;
	and.b32 %d0, %d0, 15;
	and.b32 %d1, %d1, 15;
	and.b32 %d2, %d2, 15;
	and.b32 %d3, %d3, 15;

	// Encode: digit << 4
	shl.b32 %s0, %d0, 4;
	shl.b32 %s1, %d1, 4;
	shl.b32 %s2, %d2, 4;
	shl.b32 %s3, %d3, 4;
	and.b32 %s0, %s0, 240;
	and.b32 %s1, %s1, 240;
	and.b32 %s2, %s2, 240;
	and.b32 %s3, %s3, 240;

	// Bitmask: 1 << encoded (word 0 only)
	mov.u32 %one, 1;
	shl.b32 %b0, %one, %s0;
	shl.b32 %b1, %one, %s1;
	shl.b32 %b2, %one, %s2;
	shl.b32 %b3, %one, %s3;

	// Accumulate word 0
	mov.u32 %acc, 0;
	add.s32 %acc, %acc, %b0;
	add.s32 %acc, %acc, %b1;
	add.s32 %acc, %acc, %b2;
	add.s32 %acc, %acc, %b3;

	// Store word 0 result
	st.u32 [out_addr], %acc;

	ret;
}
