.version 2.3
.target sm_10
.address_size 64


.entry legacy_sreg16(.param .u64 input, .param .u64 output)
{
    .reg .u64 out;
    .reg .u32 block, blocks, last;
    .reg .u32 a, b, c, d, e, f, g, h;
    .reg .u16 x, y, z, w;
    .reg .pred skip;
    mov.u32 block, %ctaid.x;
    mov.u32 blocks, %nctaid.x;
    sub.u32 last, blocks, 1;
    setp.ne.u32 skip, block, last;
    @skip bra done;
    mov.u16 x, %tid.x;
    mov.u16 y, %ntid.x;
    mov.u16 z, %ctaid.x;
    mov.u16 w, %nctaid.x;
    cvt.u32.u16 a, x;
    cvt.u32.u16 b, y;
    cvt.u32.u16 c, z;
    cvt.u32.u16 d, w;
    cvt.u32.u16 e, %tid.x;
    cvt.u32.u16 f, %ntid.x;
    cvt.u32.u16 g, %ctaid.x;
    cvt.u32.u16 h, %nctaid.x;
    ld.param.u64 out, [output];
    st.global.u32 [out], a;
    st.global.u32 [out+4], b;
    st.global.u32 [out+8], c;
    st.global.u32 [out+12], d;
    st.global.u32 [out+16], e;
    st.global.u32 [out+20], f;
    st.global.u32 [out+24], g;
    st.global.u32 [out+28], h;
done:
    ret;
}
