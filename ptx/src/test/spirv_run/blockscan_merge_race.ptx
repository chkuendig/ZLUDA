// Reproduces IOFX_newRadixSortStepKernel BB20_201 race pattern at scale.
//
// One launch with grid=N, block=128 (4 wave32 waves). Each block runs
// N_INNER inner iterations of the race pattern, accumulating per-thread
// saw_race count. Output[block*block_dim + tid] = saw_race.
//
// Race pattern per inner iter:
//   1. sBuf[tid] = 0xDEADBEEF
//   2. bar.sync 0
//   3. if (warpid < 2) sBuf[tid] = tid | 0x10000           // writer
//   4. (NO bar.sync — race window)
//   5. read (writer: own slot; reader-only: writer-warp slot)
//   6. if observed != expected → saw_race++
//   7. bar.sync 0
//
.version 3.2
.target sm_30
.address_size 64

.visible .entry blockscan_merge_race(
    .param .u64 blockscan_merge_race_param_0,
    .param .u32 blockscan_merge_race_param_1
)
.maxntid 128, 1, 1
{
    .reg .pred %p<8>;
    .reg .u32 %r<64>;
    .reg .u64 %rd<10>;
    .reg .f32 %f<4>;

    .shared .align 4 .u32 sBuf[128];

    ld.param.u64 %rd0, [blockscan_merge_race_param_0];
    ld.param.u32 %r0, [blockscan_merge_race_param_1];      // r0 = N_INNER
    cvta.to.global.u64 %rd1, %rd0;

    mov.u32 %r1, %tid.x;
    mov.u32 %r2, %ctaid.x;
    mov.u32 %r3, %ntid.x;

    mov.u32 %r4, sBuf;
    mul.lo.u32 %r5, %r1, 4;
    add.u32 %r6, %r4, %r5;                                  // r6 = &sBuf[tid]

    shr.u32 %r8, %r1, 5;                                    // warpid
    setp.lt.u32 %p1, %r8, 2;                                // p1 = writer

    sub.u32 %r11, %r8, 2;
    shl.b32 %r13, %r11, 5;
    and.b32 %r14, %r1, 31;
    add.u32 %r15, %r13, %r14;                               // src_idx for reader-only
    mul.lo.u32 %r16, %r15, 4;
    add.u32 %r17, %r4, %r16;                                // src_addr
    or.b32 %r18, %r15, 65536;                               // src_expected
    or.b32 %r19, %r1, 65536;                                // own_expected

    mov.u32 %r20, 0;                                        // saw_race accumulator
    mov.u32 %r21, 0;                                        // iter counter

LOOP_TOP:
    setp.ge.u32 %p2, %r21, %r0;
    @%p2 bra LOOP_END;

    mov.u32 %r22, -559038737;                               // 0xDEADBEEF
    st.shared.u32 [%r6], %r22;

    bar.sync 0;

    @!%p1 bra SKIP_WRITE;

    // FMA chain: amplify race window
    cvt.rn.f32.u32 %f1, %r1;
    fma.rn.f32 %f1, %f1, %f1, %f1;
    fma.rn.f32 %f1, %f1, %f1, %f1;
    fma.rn.f32 %f1, %f1, %f1, %f1;
    fma.rn.f32 %f1, %f1, %f1, %f1;
    fma.rn.f32 %f1, %f1, %f1, %f1;
    fma.rn.f32 %f1, %f1, %f1, %f1;
    fma.rn.f32 %f1, %f1, %f1, %f1;
    fma.rn.f32 %f1, %f1, %f1, %f1;
    fma.rn.f32 %f1, %f1, %f1, %f1;
    fma.rn.f32 %f1, %f1, %f1, %f1;
    fma.rn.f32 %f1, %f1, %f1, %f1;
    fma.rn.f32 %f1, %f1, %f1, %f1;
    fma.rn.f32 %f1, %f1, %f1, %f1;
    fma.rn.f32 %f1, %f1, %f1, %f1;
    fma.rn.f32 %f1, %f1, %f1, %f1;
    fma.rn.f32 %f1, %f1, %f1, %f1;
    mov.b32 %r23, %f1;
    and.b32 %r23, %r23, 0;

    add.u32 %r24, %r19, %r23;
    st.shared.u32 [%r6], %r24;

SKIP_WRITE:
    // NO bar.sync — the race

    @%p1 bra READ_OWN;

    // ld.volatile.shared to match the post-patch_broad_volatile_lds state
    // that production PTX is in by the time patch_divergent_lds_merge_sync
    // runs. Bug found 2026-05-13: without matching the volatile form, the
    // sync patch was a no-op on real-game NRSS PTX.
    ld.volatile.shared.u32 %r25, [%r17];
    setp.ne.s32 %p3, %r25, %r18;
    @%p3 add.u32 %r20, %r20, 1;
    bra AFTER_READ;

READ_OWN:
    ld.volatile.shared.u32 %r25, [%r6];
    setp.ne.s32 %p4, %r25, %r19;
    @%p4 add.u32 %r20, %r20, 1;

AFTER_READ:
    bar.sync 0;

    add.u32 %r21, %r21, 1;
    bra LOOP_TOP;

LOOP_END:
    mul.lo.u32 %r30, %r2, %r3;
    add.u32 %r31, %r30, %r1;
    mul.wide.u32 %rd2, %r31, 4;
    add.u64 %rd3, %rd1, %rd2;
    st.global.u32 [%rd3], %r20;

    ret;
}
