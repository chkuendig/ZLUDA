// Uniform load from the dword-aligned address in_addr + zext(idx + 2) + 2.
// The address is aligned, but its parts (idx + 2) and 2 are not. AMDGPU
// must not select them as the SGPR offset and the immediate offset of a
// scalar load: the hardware ignores their low bits and loads the dword below.
.version 6.5
.target sm_30
.address_size 64

.visible .entry ld_uniform_offset_parts(
	.param .u64 input,
	.param .u64 output
)
{
	.reg .u64 	        in_addr;
    .reg .u64 	        out_addr;
    .reg .u32 	        idx;
    .reg .u64 	        offset;
    .reg .u32 	        temp;

	ld.param.u64 	    in_addr, [input];
    ld.param.u64 	    out_addr, [output];

    cvta.to.global.u64  in_addr, in_addr;
    cvta.to.global.u64  out_addr, out_addr;

    ld.global.u32       idx, [in_addr];
    add.u32             idx, idx, 2;
    cvt.u64.u32         offset, idx;
    add.u64             in_addr, in_addr, offset;
    ld.global.u32       temp, [in_addr+2];
    st.global.u32       [out_addr], temp;
	ret;
}
