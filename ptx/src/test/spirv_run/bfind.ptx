.version 6.5
.target sm_30
.address_size 64

.visible .entry bfind(
    .param .u64 input,
    .param .u64 output
)
{
    .reg .u64 in_addr;
    .reg .u64 out_addr;
    .reg .u32 temp;

    ld.param.u64 in_addr, [input];
    ld.param.u64 out_addr, [output];
    ld.u32 temp, [in_addr];
    bfind.u32 temp, temp;
    st.u32 [out_addr], temp;
    ret;
}
