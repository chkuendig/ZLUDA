.version 6.5
.target sm_30
.address_size 64

.visible .entry shfl_sync_idx_multi_reg(
    .param .u64 output
)
{
    .reg .u64   out_addr, out_off;
    .reg .u32   tid, regA, regB, shflA, shflB;
    .reg .pred  pA, pB;

    ld.param.u64 out_addr, [output];
    mov.u32 tid, %tid.x;

    // regA = tid + 1, regB = (tid+1) * 100
    add.u32 regA, tid, 1;
    add.u32 regB, tid, 1;
    mul.lo.u32 regB, regB, 100;

    // shfl both: read from lane 0
    shfl.sync.idx.b32 shflA|pA, regA, 0, 31, 0xFFFFFFFF;
    shfl.sync.idx.b32 shflB|pB, regB, 0, 31, 0xFFFFFFFF;

    // Each thread writes [shflA, shflB] at output[tid*2]
    cvt.u64.u32 out_off, tid;
    mul.lo.u64 out_off, out_off, 8;
    add.u64 out_addr, out_addr, out_off;
    st.u32 [out_addr], shflA;
    st.u32 [out_addr+4], shflB;

    ret;
}
