.version 6.5
.target sm_30
.address_size 64

.visible .entry shfl_down_upper_half_active(
    .param .u64 output
)
{
    .reg .u64       out_addr;
    .reg .u64       out_index;
    .reg .u32       tid;
    .reg .u32       lane_id;
    .reg .u32       result;
    .reg .pred      active;
    .reg .pred      in_range;

    ld.param.u64    out_addr, [output];
    mov.u32         tid, %tid.x;
    mov.u32         lane_id, %laneid;
    mov.u32         result, tid;

    setp.ge.u32     active, lane_id, 16;
    @!active add.u32 result, result, 2000;
    @!active bra STORE;

    shfl.down.b32   result|in_range, tid, 1, 31;
    @!in_range add.u32 result, result, 1000;

STORE:
    cvt.u64.u32     out_index, tid;
    mul.lo.u64      out_index, out_index, 4;
    add.u64         out_addr, out_addr, out_index;
    st.u32          [out_addr], result;
    ret;
}
