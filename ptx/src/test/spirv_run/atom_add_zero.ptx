.version 6.5
.target sm_30
.address_size 64

// Test: atom.global.add.u32 with operand 0 must return current value
// This is the PhysX spin-wait pattern. If LLVM optimizes away the atomic
// (since adding 0 is a value no-op), the return value would be wrong.
// input[0] = value to store (e.g. 42)
// output[0] = result of atom.add.u32 [addr], 0 (must == 42)
.visible .entry atom_add_zero(
	.param .u64 input,
	.param .u64 output
)
{
	.reg .u64 	in_addr;
	.reg .u64 	out_addr;
	.reg .u32 	temp;

	ld.param.u64 	in_addr, [input];
	ld.param.u64 	out_addr, [output];

	// Do atom.global.add.u32 with 0 — must return current value
	atom.global.add.u32 temp, [in_addr], 0;
	st.u32 		[out_addr], temp;
	ret;
}
