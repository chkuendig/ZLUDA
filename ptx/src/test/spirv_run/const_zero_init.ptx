.version 6.5
.target sm_30
.address_size 64

.const .align 8 .b8 params[16];

.visible .entry const_zero_init(
    .param .u64 input,
    .param .u64 output
)
{
    .reg .u64       in_addr;
    .reg .u64       out_addr;
    .reg .u64       val0;
    .reg .u64       val1;

    ld.param.u64    in_addr, [input];
    ld.param.u64    out_addr, [output];
    ld.const.u64    val0, [params];
    ld.const.u64    val1, [params+8];
    st.u64          [out_addr], val0;
    st.u64          [out_addr+8], val1;
    ret;
}
