.version 6.5
.target sm_30
.address_size 64

// Test: take address of shared memory, add offset, access via computed address.
// This is the pattern CUB RadixSort uses. Simplified: no barrier, single value.

.shared .align 4 .b8 shared_buf[64];

.visible .entry shared_ptr_offset(
	.param .u64 input,
	.param .u64 output
)
{
	.reg .u64   in_addr;
    .reg .u64   out_addr;
    .reg .u64   shared_base;
    .reg .u64   shared_addr;
    .reg .u64   temp;

	ld.param.u64    in_addr, [input];
    ld.param.u64    out_addr, [output];

    // Take address of shared buffer
    mov.u64         shared_base, shared_buf;

    // Add 8-byte offset (access second u64 slot)
    add.s64         shared_addr, shared_base, 8;

    // Store to computed shared address
    ld.global.u64   temp, [in_addr];
    st.shared.u64   [shared_addr], temp;

    // Load back from same computed address
    ld.shared.u64   temp, [shared_addr];
    st.global.u64   [out_addr], temp;
	ret;
}
