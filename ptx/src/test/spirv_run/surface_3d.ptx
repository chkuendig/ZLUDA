.version 6.5
.target sm_30
.address_size 64

.visible .entry surface_3d(
    .param .u64 surface,
    .param .u64 output
)
{
    .reg .u64       surf;
    .reg .u64       out_addr;
    .reg .b32       x;
    .reg .b32       y;
    .reg .b32       z;
    .reg .b32       value;
    .reg .b64       wide;

    ld.param.u64    surf, [surface];
    ld.param.u64    out_addr, [output];
    mov.b32         x, 4;
    mov.b32         y, 1;
    mov.b32         z, 2;

    suld.b.3d.b32.clamp {value}, [surf, {x, y, z, z}];
    sust.b.3d.b32.zero [surf, {x, y, z, z}], {value};
    sust.b.3d.v4.b32.trap [surf, {x, y, z, z}], {value, value, value, value};
    mov.b64         wide, {value, value};
    sust.b.3d.b64.zero [surf, {x, y, z, z}], {wide};
    sust.b.2d.b32.zero [surf, {x, y}], {value};
    st.global.u32   [out_addr], value;
    ret;
}
