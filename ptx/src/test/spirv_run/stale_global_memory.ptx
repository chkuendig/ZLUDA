.version 6.5
.target sm_30
.address_size 64

// Test: stale_global_memory
//
// Reproduces the PhysX CreateParticleShapesIncremental crash caused by stale
// sentinel values in global memory persisting between kernel launches.
//
// Pipeline (models PhysX Stages 1-4):
//   phase1_init: writes valid counts to records[i].field = i+1
//   phase2_mark: marks records as "processed" by writing -1 to field
//   phase3_read: reads records[i].field, subtracts 1, writes to counters[i]
//                If field=-1 (stale), counter=-2 → corrupt
//   phase4_scatter: uses counter as index for scatter-write
//                   If counter=-2, writes to wild address → GPU fault
//
// The bug: between iterations, phase2_mark writes -1, but phase1_init only
// reinitializes SOME entries. Entries not reinitialized retain -1 from phase2.
// On NVIDIA, this doesn't crash (different memory/timing behavior).
// On AMD, phase3_read sees stale -1, computes -2, phase4_scatter faults.
//
// Layout:
//   input:  [N, records_ptr, counters_ptr, output_ptr, reinit_mask]
//   records: N entries, 4 bytes each (the "field")
//   counters: N entries, 4 bytes each
//   output: N entries, 4 bytes each (scatter-write target)

// Phase 1: Initialize records with valid counts (but skip some based on mask)
// param_0 = pointer to records (u64)
// param_1 = N (u32)
// param_2 = reinit_mask — bitmask of which entries to reinitialize (u32)
.visible .entry phase1_init(
    .param .u64 phase1_init_param_0,
    .param .u32 phase1_init_param_1,
    .param .u32 phase1_init_param_2
)
{
    .reg .pred %p<2>;
    .reg .u32 %r<8>;
    .reg .u64 %rd<4>;

    ld.param.u64 %rd1, [phase1_init_param_0];
    ld.param.u32 %r1, [phase1_init_param_1];
    ld.param.u32 %r2, [phase1_init_param_2];
    cvta.to.global.u64 %rd2, %rd1;

    mov.u32 %r3, %tid.x;
    setp.ge.u32 %p1, %r3, %r1;
    @%p1 bra DONE1;

    // Check if this entry should be reinitialized (bit set in mask)
    shl.b32 %r4, 1, %r3;
    and.b32 %r5, %r2, %r4;
    setp.eq.u32 %p1, %r5, 0;
    @%p1 bra DONE1;

    // Write valid count: records[tid] = tid + 1
    add.u32 %r6, %r3, 1;
    mul.wide.u32 %rd3, %r3, 4;
    add.u64 %rd2, %rd2, %rd3;
    st.global.u32 [%rd2], %r6;

DONE1:
    ret;
}

// Phase 2: Mark records as "processed" (write -1 sentinel)
// param_0 = pointer to records (u64)
// param_1 = N (u32)
.visible .entry phase2_mark(
    .param .u64 phase2_mark_param_0,
    .param .u32 phase2_mark_param_1
)
{
    .reg .pred %p<2>;
    .reg .u32 %r<4>;
    .reg .u64 %rd<4>;

    ld.param.u64 %rd1, [phase2_mark_param_0];
    ld.param.u32 %r1, [phase2_mark_param_1];
    cvta.to.global.u64 %rd2, %rd1;

    mov.u32 %r2, %tid.x;
    setp.ge.u32 %p1, %r2, %r1;
    @%p1 bra DONE2;

    // Mark as processed: records[tid] = -1
    mov.u32 %r3, 0xFFFFFFFF;
    mul.wide.u32 %rd3, %r2, 4;
    add.u64 %rd2, %rd2, %rd3;
    st.global.u32 [%rd2], %r3;

DONE2:
    ret;
}

// Phase 3: Read records and compute counters (the Stage_2_Batched equivalent)
// param_0 = pointer to records (u64)
// param_1 = pointer to counters output (u64)
// param_2 = N (u32)
.visible .entry phase3_read(
    .param .u64 phase3_read_param_0,
    .param .u64 phase3_read_param_1,
    .param .u32 phase3_read_param_2
)
{
    .reg .pred %p<2>;
    .reg .u32 %r<6>;
    .reg .u64 %rd<6>;

    ld.param.u64 %rd1, [phase3_read_param_0];
    ld.param.u64 %rd2, [phase3_read_param_1];
    ld.param.u32 %r1, [phase3_read_param_2];
    cvta.to.global.u64 %rd3, %rd1;
    cvta.to.global.u64 %rd4, %rd2;

    mov.u32 %r2, %tid.x;
    setp.ge.u32 %p1, %r2, %r1;
    @%p1 bra DONE3;

    // Read records[tid] and subtract 1 (exactly what Stage_2_Batched does)
    mul.wide.u32 %rd5, %r2, 4;
    add.u64 %rd3, %rd3, %rd5;
    ld.global.u32 %r3, [%rd3];
    add.s32 %r4, %r3, -1;

    // Write to counters[tid]
    add.u64 %rd4, %rd4, %rd5;
    st.global.u32 [%rd4], %r4;

DONE3:
    ret;
}
