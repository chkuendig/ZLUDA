.version 6.5
.target sm_30
.address_size 64

// Test the exact PhysX radix sort histogram packing pattern:
// For each digit d (0-15): result = 1 << ((d << 4) & 0xF0)
// Expected: d=0 → 1, d=1 → 0x10000, d=2 → 0 (shift=32), d=3 → 0 (shift=48)
.visible .entry shl_packed(
	.param .u64 input,
	.param .u64 output
)
{
	.reg .u64 in_addr, out_addr;
	.reg .u32 %d0, %d1, %d2, %d3;
	.reg .u32 %s0, %s1, %s2, %s3;
	.reg .u32 %r0, %r1, %r2, %r3;
	.reg .u32 %one;

	ld.param.u64 in_addr, [input];
	ld.param.u64 out_addr, [output];

	// Load 4 digit values
	ld.u32 %d0, [in_addr];
	ld.u32 %d1, [in_addr+4];
	ld.u32 %d2, [in_addr+8];
	ld.u32 %d3, [in_addr+12];

	// Compute shift amount: (digit << 4) & 0xF0
	shl.b32 %s0, %d0, 4;
	shl.b32 %s1, %d1, 4;
	shl.b32 %s2, %d2, 4;
	shl.b32 %s3, %d3, 4;
	and.b32 %s0, %s0, 240;
	and.b32 %s1, %s1, 240;
	and.b32 %s2, %s2, 240;
	and.b32 %s3, %s3, 240;

	// Compute 1 << shift
	mov.u32 %one, 1;
	shl.b32 %r0, %one, %s0;
	shl.b32 %r1, %one, %s1;
	shl.b32 %r2, %one, %s2;
	shl.b32 %r3, %one, %s3;

	// Store results
	st.u32 [out_addr], %r0;
	st.u32 [out_addr+4], %r1;
	st.u32 [out_addr+8], %r2;
	st.u32 [out_addr+12], %r3;

	ret;
}
