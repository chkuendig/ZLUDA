.version 6.5
.target sm_30
.address_size 64

// Test: atom.global.cas.b32 with -2 (0xFFFFFFFE) compare, 0 swap
// PhysX MS_1 pattern: if *addr == -2, set to 0, return old value
// input[0] = 0xFFFFFFFE (-2 as u32) — the cell to claim
// input[1] = 0x00000005 — a cell that should NOT be claimed
// output[0] = old value from CAS on input[0] (should be 0xFFFFFFFE)
// output[1] = new value at input[0] after CAS (should be 0)
// output[2] = old value from CAS on input[1] (should be 5, CAS fails)
// output[3] = new value at input[1] after CAS (should still be 5)
.visible .entry atom_cas_b32(
	.param .u64 input,
	.param .u64 output
)
{
	.reg .u64 	in_addr;
	.reg .u64 	out_addr;
	.reg .u32 	old1;
	.reg .u32 	old2;
	.reg .u32 	val;

	ld.param.u64 	in_addr, [input];
	ld.param.u64 	out_addr, [output];

	// CAS: compare with -2 (0xFFFFFFFE), swap to 0
	atom.global.cas.b32 old1, [in_addr], -2, 0;
	st.u32 		[out_addr], old1;

	// Read back the value after CAS
	ld.global.u32 	val, [in_addr];
	st.u32 		[out_addr+4], val;

	// CAS on input[1] which is 5, not -2 — should fail
	atom.global.cas.b32 old2, [in_addr+4], -2, 0;
	st.u32 		[out_addr+8], old2;

	// Read back — should still be 5
	ld.global.u32 	val, [in_addr+4];
	st.u32 		[out_addr+12], val;

	ret;
}
