.version 6.5
.target sm_30
.address_size 64

// Test shl.b32 with shift amounts >= 32 (NVIDIA returns 0, AMD wraps modulo 32)
// Input: [0, 16, 32, 48] (shift amounts)
// Expected output: [1, 0x10000, 0, 0] (NVIDIA PTX semantics: shift >= 32 → 0)
.visible .entry shl_overflow(
	.param .u64 input,
	.param .u64 output
)
{
	.reg .u64 in_addr, out_addr;
	.reg .u32 %shift0, %shift1, %shift2, %shift3;
	.reg .u32 %result0, %result1, %result2, %result3;
	.reg .u32 %one;

	ld.param.u64 in_addr, [input];
	ld.param.u64 out_addr, [output];

	// Load 4 shift amounts
	ld.u32 %shift0, [in_addr];
	ld.u32 %shift1, [in_addr+4];
	ld.u32 %shift2, [in_addr+8];
	ld.u32 %shift3, [in_addr+12];

	// Compute 1 << shift (PTX says: shift >= 32 → result is 0)
	mov.u32 %one, 1;
	shl.b32 %result0, %one, %shift0;
	shl.b32 %result1, %one, %shift1;
	shl.b32 %result2, %one, %shift2;
	shl.b32 %result3, %one, %shift3;

	// Store results
	st.u32 [out_addr], %result0;
	st.u32 [out_addr+4], %result1;
	st.u32 [out_addr+8], %result2;
	st.u32 [out_addr+12], %result3;

	ret;
}
