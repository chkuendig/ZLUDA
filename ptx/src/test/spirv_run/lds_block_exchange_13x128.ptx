.version 3.2
.target sm_30
.address_size 64

// Minimal reproduction of the Downsweep key block-exchange stage:
// scatter 13 items per thread to dynamic shared indices at base+136+4*rank,
// then barrier and gather back in blocked order from 136 + 512*item + 4*tid.
.visible .entry lds_block_exchange_13x128_test(
    .param .u64 lds_block_exchange_13x128_test_param_0
)
.maxntid 128, 1, 1
{
    .reg .pred %p<2>;
    .reg .u32 %r<32>;
    .reg .u64 %rd<8>;
    .shared .align 4 .u32 smem[1700];

    ld.param.u64 %rd0, [lds_block_exchange_13x128_test_param_0];
    cvta.to.global.u64 %rd1, %rd0;

    mov.u32 %r0, %tid.x;
    setp.ge.u32 %p0, %r0, 128;
    @%p0 bra DONE;

    mov.u32 %r1, smem;
    mul.lo.u32 %r2, %r0, 13;
    mul.lo.u32 %r3, %r0, 4;
    cvt.u64.u32 %rd2, %r3;
    add.u64 %rd2, %rd1, %rd2;

    // Scatter values using a transposed rank: rank = tid * 13 + item.
    mov.u32 %r4, 0x10000000;
    add.u32 %r5, %r2, 0;
    mul.lo.u32 %r5, %r5, 4;
    add.u32 %r5, %r5, 136;
    add.u32 %r5, %r5, %r1;
    add.u32 %r6, %r4, %r0;
    st.shared.u32 [%r5], %r6;

    add.u32 %r5, %r2, 1;
    mul.lo.u32 %r5, %r5, 4;
    add.u32 %r5, %r5, 136;
    add.u32 %r5, %r5, %r1;
    add.u32 %r6, %r4, 128;
    add.u32 %r6, %r6, %r0;
    st.shared.u32 [%r5], %r6;

    add.u32 %r5, %r2, 2;
    mul.lo.u32 %r5, %r5, 4;
    add.u32 %r5, %r5, 136;
    add.u32 %r5, %r5, %r1;
    add.u32 %r6, %r4, 256;
    add.u32 %r6, %r6, %r0;
    st.shared.u32 [%r5], %r6;

    add.u32 %r5, %r2, 3;
    mul.lo.u32 %r5, %r5, 4;
    add.u32 %r5, %r5, 136;
    add.u32 %r5, %r5, %r1;
    add.u32 %r6, %r4, 384;
    add.u32 %r6, %r6, %r0;
    st.shared.u32 [%r5], %r6;

    add.u32 %r5, %r2, 4;
    mul.lo.u32 %r5, %r5, 4;
    add.u32 %r5, %r5, 136;
    add.u32 %r5, %r5, %r1;
    add.u32 %r6, %r4, 512;
    add.u32 %r6, %r6, %r0;
    st.shared.u32 [%r5], %r6;

    add.u32 %r5, %r2, 5;
    mul.lo.u32 %r5, %r5, 4;
    add.u32 %r5, %r5, 136;
    add.u32 %r5, %r5, %r1;
    add.u32 %r6, %r4, 640;
    add.u32 %r6, %r6, %r0;
    st.shared.u32 [%r5], %r6;

    add.u32 %r5, %r2, 6;
    mul.lo.u32 %r5, %r5, 4;
    add.u32 %r5, %r5, 136;
    add.u32 %r5, %r5, %r1;
    add.u32 %r6, %r4, 768;
    add.u32 %r6, %r6, %r0;
    st.shared.u32 [%r5], %r6;

    add.u32 %r5, %r2, 7;
    mul.lo.u32 %r5, %r5, 4;
    add.u32 %r5, %r5, 136;
    add.u32 %r5, %r5, %r1;
    add.u32 %r6, %r4, 896;
    add.u32 %r6, %r6, %r0;
    st.shared.u32 [%r5], %r6;

    add.u32 %r5, %r2, 8;
    mul.lo.u32 %r5, %r5, 4;
    add.u32 %r5, %r5, 136;
    add.u32 %r5, %r5, %r1;
    add.u32 %r6, %r4, 1024;
    add.u32 %r6, %r6, %r0;
    st.shared.u32 [%r5], %r6;

    add.u32 %r5, %r2, 9;
    mul.lo.u32 %r5, %r5, 4;
    add.u32 %r5, %r5, 136;
    add.u32 %r5, %r5, %r1;
    add.u32 %r6, %r4, 1152;
    add.u32 %r6, %r6, %r0;
    st.shared.u32 [%r5], %r6;

    add.u32 %r5, %r2, 10;
    mul.lo.u32 %r5, %r5, 4;
    add.u32 %r5, %r5, 136;
    add.u32 %r5, %r5, %r1;
    add.u32 %r6, %r4, 1280;
    add.u32 %r6, %r6, %r0;
    st.shared.u32 [%r5], %r6;

    add.u32 %r5, %r2, 11;
    mul.lo.u32 %r5, %r5, 4;
    add.u32 %r5, %r5, 136;
    add.u32 %r5, %r5, %r1;
    add.u32 %r6, %r4, 1408;
    add.u32 %r6, %r6, %r0;
    st.shared.u32 [%r5], %r6;

    add.u32 %r5, %r2, 12;
    mul.lo.u32 %r5, %r5, 4;
    add.u32 %r5, %r5, 136;
    add.u32 %r5, %r5, %r1;
    add.u32 %r6, %r4, 1536;
    add.u32 %r6, %r6, %r0;
    st.shared.u32 [%r5], %r6;

    bar.sync 0;

    // Gather back in blocked order.
    add.u32 %r7, %r3, 136;
    add.u32 %r7, %r7, %r1;
    ld.shared.u32 %r8, [%r7+0];
    st.global.u32 [%rd2+0], %r8;
    ld.shared.u32 %r8, [%r7+512];
    st.global.u32 [%rd2+512], %r8;
    ld.shared.u32 %r8, [%r7+1024];
    st.global.u32 [%rd2+1024], %r8;
    ld.shared.u32 %r8, [%r7+1536];
    st.global.u32 [%rd2+1536], %r8;
    ld.shared.u32 %r8, [%r7+2048];
    st.global.u32 [%rd2+2048], %r8;
    ld.shared.u32 %r8, [%r7+2560];
    st.global.u32 [%rd2+2560], %r8;
    ld.shared.u32 %r8, [%r7+3072];
    st.global.u32 [%rd2+3072], %r8;
    ld.shared.u32 %r8, [%r7+3584];
    st.global.u32 [%rd2+3584], %r8;
    ld.shared.u32 %r8, [%r7+4096];
    st.global.u32 [%rd2+4096], %r8;
    ld.shared.u32 %r8, [%r7+4608];
    st.global.u32 [%rd2+4608], %r8;
    ld.shared.u32 %r8, [%r7+5120];
    st.global.u32 [%rd2+5120], %r8;
    ld.shared.u32 %r8, [%r7+5632];
    st.global.u32 [%rd2+5632], %r8;
    ld.shared.u32 %r8, [%r7+6144];
    st.global.u32 [%rd2+6144], %r8;

DONE:
    ret;
}
