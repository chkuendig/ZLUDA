.version 6.5
.target sm_30
.address_size 64

.visible .entry ld_st_offset_64bit(
    .param .u64 input,
    .param .u64 output
)
{
    .reg .u64       in_addr;
    .reg .u64       out_addr;
    .reg .u32       temp;

    ld.param.u64    in_addr, [input];
    ld.param.u64    out_addr, [output];

    ld.global.u32   temp, [in_addr+17179869180];
    st.global.u32   [out_addr+8589934592], temp;
    ret;
}
