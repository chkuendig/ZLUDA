.version 6.5
.target sm_30
.address_size 64

.visible .entry maxntid_cap_run(
	.param .u64 input,
	.param .u64 output
)
.maxntid 1024, 1, 1
{
	.reg .u64 	    in_addr;
    .reg .u64 	    out_addr;
    .reg .u64 	    temp;
    .reg .u64 	    temp2;
    .reg .u32       tid;
    .reg .pred      is_thread0;

	ld.param.u64 	in_addr, [input];
    ld.param.u64 	out_addr, [output];

    mov.u32         tid, %tid.x;
    setp.eq.u32     is_thread0, tid, 0;
    @!is_thread0 bra DONE;

    ld.u64          temp, [in_addr];
	add.u64		    temp2, temp, 1;
    st.u64          [out_addr], temp2;

DONE:
	ret;
}
