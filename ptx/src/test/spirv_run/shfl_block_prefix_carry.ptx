.version 6.5
.target sm_30
.address_size 64

// 128-thread block prefix sum:
// 1. per-warp inclusive scan via 5 shfl.up steps
// 2. lane 31 of each warp stores the warp total to shared memory
// 3. warp 0 scans those 4 warp totals
// 4. later warps add the previous warp's scanned total as carry-in
.visible .entry shfl_block_prefix_carry(
    .param .u64 output
)
{
    .reg .u64 out_addr, out_index;
    .reg .u32 tid, lane, warp, val, tmp, carry, warp_off, prev_warp, smem_base, smem_addr;
    .reg .pred p, p1, p2;
    .shared .align 4 .u32 warp_totals[4];

    ld.param.u64 out_addr, [output];
    mov.u32 tid, %tid.x;
    mov.u32 lane, %laneid;
    shr.u32 warp, tid, 5;
    mov.u32 val, 1;
    mov.u32 smem_base, warp_totals;

    shfl.up.b32 tmp|p, val, 0x1, 0x0;
    @p add.u32 val, tmp, val;
    shfl.up.b32 tmp|p, val, 0x2, 0x0;
    @p add.u32 val, tmp, val;
    shfl.up.b32 tmp|p, val, 0x4, 0x0;
    @p add.u32 val, tmp, val;
    shfl.up.b32 tmp|p, val, 0x8, 0x0;
    @p add.u32 val, tmp, val;
    shfl.up.b32 tmp|p, val, 0x10, 0x0;
    @p add.u32 val, tmp, val;

    setp.eq.u32 p, lane, 31;
    @!p bra WARP_TOTAL_DONE;
    mul.lo.u32 warp_off, warp, 4;
    add.u32 smem_addr, smem_base, warp_off;
    st.shared.u32 [smem_addr], val;

WARP_TOTAL_DONE:
    bar.sync 0;

    setp.eq.u32 p, warp, 0;
    @!p bra CARRY_SCAN_DONE;

    setp.lt.u32 p1, lane, 4;
    @p1 mul.lo.u32 warp_off, lane, 4;
    @p1 add.u32 smem_addr, smem_base, warp_off;
    @p1 ld.shared.u32 carry, [smem_addr];
    @!p1 mov.u32 carry, 0;

    shfl.up.b32 tmp|p2, carry, 0x1, 0x0;
    @p2 add.u32 carry, tmp, carry;
    shfl.up.b32 tmp|p2, carry, 0x2, 0x0;
    @p2 add.u32 carry, tmp, carry;
    shfl.up.b32 tmp|p2, carry, 0x4, 0x0;
    @p2 add.u32 carry, tmp, carry;
    shfl.up.b32 tmp|p2, carry, 0x8, 0x0;
    @p2 add.u32 carry, tmp, carry;
    shfl.up.b32 tmp|p2, carry, 0x10, 0x0;
    @p2 add.u32 carry, tmp, carry;

    @!p1 bra CARRY_SCAN_DONE;
    st.shared.u32 [smem_addr], carry;

CARRY_SCAN_DONE:
    bar.sync 0;

    setp.eq.u32 p, warp, 0;
    @p bra STORE;

    sub.u32 prev_warp, warp, 1;
    mul.lo.u32 warp_off, prev_warp, 4;
    add.u32 smem_addr, smem_base, warp_off;
    ld.shared.u32 carry, [smem_addr];
    add.u32 val, val, carry;

STORE:
    cvt.u64.u32 out_index, tid;
    mul.lo.u64 out_index, out_index, 4;
    add.u64 out_addr, out_addr, out_index;
    st.u32 [out_addr], val;
    ret;
}
