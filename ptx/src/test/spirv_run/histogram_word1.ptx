.version 6.5
.target sm_30
.address_size 64

// Test word 1 of the PhysX packed histogram.
// Word 1 = 1 << ((digit*16) - 32) for digits 2-3.
// Input: 4 keys [2, 3, 4, 0]
// Digits (& 0xF): [2, 3, 4, 0]
// Encoded (digit << 4): [32, 48, 64, 0]
// Word 1 = 1 << (encoded - 32):
//   key 2: 1 << (32-32) = 1 << 0 = 1     (digit 2, low 16 bits)
//   key 3: 1 << (48-32) = 1 << 16 = 0x10000 (digit 3, high 16 bits)
//   key 4: 1 << (64-32) = 1 << 32 = 0 (clamped, digit 4 goes to word 2)
//   key 0: 1 << (0-32)  = 1 << (-32) = 0 (clamped, digit 0 goes to word 0)
// Word 1 accumulator = 1 + 0x10000 + 0 + 0 = 0x00010001
// Output: [0x00010001]

.visible .entry histogram_word1(
	.param .u64 input,
	.param .u64 output
)
{
	.reg .u64 in_addr, out_addr;
	.reg .u32 %k0, %k1, %k2, %k3;
	.reg .u32 %d0, %d1, %d2, %d3;
	.reg .u32 %s0, %s1, %s2, %s3;
	.reg .u32 %a0, %a1, %a2, %a3;
	.reg .u32 %b0, %b1, %b2, %b3;
	.reg .u32 %acc, %one, %shift;

	ld.param.u64 in_addr, [input];
	ld.param.u64 out_addr, [output];

	ld.u32 %k0, [in_addr];
	ld.u32 %k1, [in_addr+4];
	ld.u32 %k2, [in_addr+8];
	ld.u32 %k3, [in_addr+12];

	// Extract digit
	mov.u32 %shift, 0;
	shr.u32 %d0, %k0, %shift;
	shr.u32 %d1, %k1, %shift;
	shr.u32 %d2, %k2, %shift;
	shr.u32 %d3, %k3, %shift;
	and.b32 %d0, %d0, 15;
	and.b32 %d1, %d1, 15;
	and.b32 %d2, %d2, 15;
	and.b32 %d3, %d3, 15;

	// Encode
	shl.b32 %s0, %d0, 4;
	shl.b32 %s1, %d1, 4;
	shl.b32 %s2, %d2, 4;
	shl.b32 %s3, %d3, 4;
	and.b32 %s0, %s0, 240;
	and.b32 %s1, %s1, 240;
	and.b32 %s2, %s2, 240;
	and.b32 %s3, %s3, 240;

	// Word 1: 1 << (encoded - 32)
	mov.u32 %one, 1;
	add.s32 %a0, %s0, -32;
	add.s32 %a1, %s1, -32;
	add.s32 %a2, %s2, -32;
	add.s32 %a3, %s3, -32;
	shl.b32 %b0, %one, %a0;
	shl.b32 %b1, %one, %a1;
	shl.b32 %b2, %one, %a2;
	shl.b32 %b3, %one, %a3;

	// Accumulate
	mov.u32 %acc, 0;
	add.s32 %acc, %acc, %b0;
	add.s32 %acc, %acc, %b1;
	add.s32 %acc, %acc, %b2;
	add.s32 %acc, %acc, %b3;

	st.u32 [out_addr], %acc;
	ret;
}
