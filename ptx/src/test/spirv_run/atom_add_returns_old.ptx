.version 6.5
.target sm_30
.address_size 64

// Test: atom.global.add.u32 returns the OLD value, not the new value.
// Input:  [0] = initial counter value (e.g. 5)
// Output: [0] = return value of atom.add (should be 5 = old)
//         [4] = value in counter AFTER the atomic (should be 4 = old - 1)

.visible .entry atom_add_returns_old(
    .param .u64 atom_add_returns_old_param_0,
    .param .u64 atom_add_returns_old_param_1
)
{
    .reg .u64 %rd<4>;
    .reg .u32 %r<3>;

    ld.param.u64 %rd1, [atom_add_returns_old_param_0];  // input ptr
    ld.param.u64 %rd2, [atom_add_returns_old_param_1];  // output ptr
    cvta.to.global.u64 %rd1, %rd1;
    cvta.to.global.u64 %rd2, %rd2;

    // Atomic add -1 to input[0], get old value
    atom.global.add.u32 %r1, [%rd1], -1;

    // Store old value to output[0]
    st.global.u32 [%rd2], %r1;

    // Load counter AFTER atomic (should be old - 1)
    ld.global.u32 %r2, [%rd1];
    st.global.u32 [%rd2+4], %r2;

    ret;
}
