    add.u32 %r22, %r22, %r2;
    shl.b32 %r23, %r20, 1;
    add.u32 %r22, %r22, %r23;
    ld.shared.u16 %r24, [%r22];
    add.u32 %r24, %r24, 1;
    st.shared.u16 [%r22], %r24;

    bfe.u32 %r20, %r11, 0, 1;
    bfe.u32 %r21, %r11, 4, 4;
    mul.lo.u32 %r22, %r21, 512;
    add.u32 %r22, %r22, %r1;
    add.u32 %r22, %r22, 160;
    add.u32 %r22, %r22, %r2;
    shl.b32 %r23, %r20, 1;
