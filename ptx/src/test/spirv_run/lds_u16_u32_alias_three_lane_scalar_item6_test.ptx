    ld.global.u32 %r15, [%rd5+44];
    st.shared.u32 [%r18+44], %r15;
    ld.global.u32 %r16, [%rd5+48];
    st.shared.u32 [%r18+48], %r16;

    bar.sync 0;

    xor.b32 %r4, %r4, 0x80000000;
    xor.b32 %r5, %r5, 0x80000000;
    xor.b32 %r6, %r6, 0x80000000;
    xor.b32 %r7, %r7, 0x80000000;
    xor.b32 %r8, %r8, 0x80000000;
