.version 3.2
.target sm_30
.address_size 64

// Same three-lane counter-update reproducer as lds_u16_u32_alias_three_lane_reread_test,
// but reread only item 6 from each lane window so the backend uses scalar ds_read_b32.
.visible .entry lds_u16_u32_alias_three_lane_scalar_item6_test(
    .param .u64 lds_u16_u32_alias_three_lane_scalar_item6_test_param_0,
    .param .u64 lds_u16_u32_alias_three_lane_scalar_item6_test_param_1
)
.maxntid 3, 1, 1
{
    .reg .pred %p<2>;
    .reg .u32 %r<48>;
    .reg .u64 %rd<8>;
    .shared .align 4 .u32 smem[2100];

    ld.param.u64 %rd0, [lds_u16_u32_alias_three_lane_scalar_item6_test_param_0];
