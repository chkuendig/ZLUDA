    mov.u32 %r19, 0;
    st.shared.u32 [%r1+160], %r19;
    st.shared.u32 [%r1+672], %r19;
    st.shared.u32 [%r1+1184], %r19;
    st.shared.u32 [%r1+1696], %r19;
    st.shared.u32 [%r1+2208], %r19;
