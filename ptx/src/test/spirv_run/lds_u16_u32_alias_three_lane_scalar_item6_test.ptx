    add.u32 %r24, %r24, 1;
    st.shared.u16 [%r22], %r24;

    bfe.u32 %r20, %r10, 0, 1;
    bfe.u32 %r21, %r10, 4, 4;
    mul.lo.u32 %r22, %r21, 512;
    add.u32 %r22, %r22, %r1;
