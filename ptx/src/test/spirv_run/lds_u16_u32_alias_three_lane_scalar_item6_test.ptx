    mul.lo.u32 %r17, %r0, 52;
    add.u32 %r18, %r1, %r17;
    add.u32 %r18, %r18, 136;

    ld.global.u32 %r4, [%rd5+0];
    st.shared.u32 [%r18+0], %r4;
    ld.global.u32 %r5, [%rd5+4];
    st.shared.u32 [%r18+4], %r5;
    ld.global.u32 %r6, [%rd5+8];
    st.shared.u32 [%r18+8], %r6;
    ld.global.u32 %r7, [%rd5+12];
    st.shared.u32 [%r18+12], %r7;
    ld.global.u32 %r8, [%rd5+16];
    st.shared.u32 [%r18+16], %r8;
    ld.global.u32 %r9, [%rd5+20];
    st.shared.u32 [%r18+20], %r9;
