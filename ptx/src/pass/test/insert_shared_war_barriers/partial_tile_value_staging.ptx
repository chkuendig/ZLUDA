// Partial-tile variant: guarded global stores split the exchange read-back and the value
// staging into different blocks. The staging block has its own barrier after the stores.
.version 6.5
.target sm_30
.address_size 64

.shared .align 4 .b8 temp_storage[8864];

.visible .entry partial_tile_value_staging(
	.param .u64 keys_out,
	.param .u64 values_in,
	.param .u32 tid_in,
	.param .u32 valid
)
{
	.reg .pred 	%p<2>;
	.reg .b32 	%r<8>;
	.reg .b64 	%rd<8>;

	ld.param.u64 	%rd1, [keys_out];
	ld.param.u64 	%rd2, [values_in];
	ld.param.u32 	%r1, [tid_in];
	ld.param.u32 	%r2, [valid];
	mov.u64 	%rd3, temp_storage;
	mul.wide.u32 	%rd4, %r1, 4;
	add.s64 	%rd5, %rd3, %rd4;
	mul.wide.u32 	%rd6, %r1, 52;
	add.s64 	%rd7, %rd3, %rd6;
	bar.sync 	0;
	ld.shared.u32 	%r3, [%rd5+136];
	setp.ge.u32 	%p1, %r1, %r2;
	@%p1 bra 	BB_STAGE;
	st.global.u32 	[%rd1], %r3;
BB_STAGE:
	ld.global.u32 	%r4, [%rd2];
	st.shared.u32 	[%rd7+136], %r4;
	ld.shared.u32 	%r5, [%rd5+136];
	bar.sync 	0;
	st.global.u32 	[%rd1+4], %r5;
	ret;
}
