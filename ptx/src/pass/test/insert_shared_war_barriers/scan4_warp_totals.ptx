// CUDPP scan4 as built into NVIDIA's PhysX 2.x runtimes (FluidMark module fc3222dd, PTX
// lines 3319-3399), shortened to one warp-scan step. After the barrier every warp zero-pads
// its scan window with a volatile store and scans it, then lane 31 stores the warp total
// into temp[warp] in a block of its own. temp[0..31] is warp 0's padding, so a delayed
// warp 0 can zero another warp's total. The barrier goes at the end of the scan block,
// before the lane-31 branch.
.version 6.5
.target sm_30
.address_size 64

.extern .shared .align 4 .b8 temp[];

.visible .entry scan4_warp_totals(
	.param .u64 out,
	.param .u32 tid_in
)
{
	.reg .pred 	%p<2>;
	.reg .b32 	%r<16>;
	.reg .b64 	%rd<12>;

	ld.param.u64 	%rd1, [out];
	ld.param.u32 	%r1, [tid_in];
	mov.u64 	%rd2, temp;
	mul.wide.u32 	%rd3, %r1, 4;
	add.s64 	%rd4, %rd2, %rd3;
	ld.shared.u32 	%r2, [%rd4];
	bar.sync 	0;
	and.b32 	%r3, %r1, 31;
	shl.b32 	%r4, %r1, 1;
	sub.s32 	%r5, %r4, %r3;
	mul.wide.u32 	%rd5, %r5, 4;
	add.s64 	%rd6, %rd2, %rd5;
	mov.u32 	%r6, 0;
	st.volatile.shared.u32 	[%rd6], %r6;
	st.volatile.shared.u32 	[%rd6+128], %r2;
	ld.volatile.shared.u32 	%r7, [%rd6+124];
	ld.volatile.shared.u32 	%r8, [%rd6+128];
	add.s32 	%r9, %r7, %r8;
	st.volatile.shared.u32 	[%rd6+128], %r9;
	ld.volatile.shared.u32 	%r10, [%rd6+124];
	setp.ne.s32 	%p1, %r3, 31;
	@%p1 bra 	BB_TOTALS_DONE;
	shr.u32 	%r11, %r1, 5;
	mul.wide.u32 	%rd7, %r11, 4;
	add.s64 	%rd8, %rd2, %rd7;
	add.s32 	%r12, %r10, %r2;
	st.shared.u32 	[%rd8], %r12;
BB_TOTALS_DONE:
	bar.sync 	0;
	ld.shared.u32 	%r13, [%rd4];
	st.global.u32 	[%rd1], %r13;
	ret;
}
