// CUDPP-style warp scan that keeps the warp totals in a .shared variable of their own.
// The volatile window stores are pending, but the lane-31 store goes to another
// variable. After the next barrier each thread reads its scan window with volatile
// loads and writes its own slot back with a weak store; volatile loads never become
// pending. No barrier may be inserted.
.version 6.5
.target sm_30
.address_size 64

.shared .align 4 .b8 scan_buf[1024];
.shared .align 4 .b8 warp_totals[128];

.visible .entry warp_scan_volatile_only(
	.param .u64 out,
	.param .u32 tid_in
)
{
	.reg .pred 	%p<2>;
	.reg .b32 	%r<16>;
	.reg .b64 	%rd<12>;

	ld.param.u64 	%rd1, [out];
	ld.param.u32 	%r1, [tid_in];
	mov.u64 	%rd2, scan_buf;
	and.b32 	%r3, %r1, 31;
	shl.b32 	%r4, %r1, 1;
	sub.s32 	%r5, %r4, %r3;
	mul.wide.u32 	%rd5, %r5, 4;
	add.s64 	%rd6, %rd2, %rd5;
	mov.u32 	%r6, 0;
	bar.sync 	0;
	st.volatile.shared.u32 	[%rd6], %r6;
	st.volatile.shared.u32 	[%rd6+128], %r1;
	ld.volatile.shared.u32 	%r7, [%rd6+124];
	ld.volatile.shared.u32 	%r8, [%rd6+128];
	add.s32 	%r9, %r7, %r8;
	st.volatile.shared.u32 	[%rd6+128], %r9;
	ld.volatile.shared.u32 	%r10, [%rd6+124];
	setp.ne.s32 	%p1, %r3, 31;
	@%p1 bra 	BB_TOTALS_DONE;
	mov.u64 	%rd7, warp_totals;
	shr.u32 	%r11, %r1, 5;
	mul.wide.u32 	%rd8, %r11, 4;
	add.s64 	%rd9, %rd7, %rd8;
	st.shared.u32 	[%rd9], %r10;
BB_TOTALS_DONE:
	bar.sync 	0;
	ld.volatile.shared.u32 	%r12, [%rd6+124];
	ld.volatile.shared.u32 	%r13, [%rd6+128];
	add.s32 	%r14, %r12, %r13;
	st.shared.u32 	[%rd6+128], %r14;
	bar.sync 	0;
	st.global.u32 	[%rd1], %r14;
	ret;
}
