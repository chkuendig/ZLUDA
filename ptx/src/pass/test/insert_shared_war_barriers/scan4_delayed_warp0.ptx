// scan4_warp_totals.ptx with a warp-0-only delay loop between the barrier and the zero
// padding, as in the FluidMark scheduling witness (scan4-bias.py). The padding block has
// no barrier of its own. It is the only way out of the barrier-free region that starts
// at the barrier block, so the barrier goes at its end, before the lane-31 branch.
.version 6.5
.target sm_30
.address_size 64

.extern .shared .align 4 .b8 temp[];

.visible .entry scan4_delayed_warp0(
	.param .u64 out,
	.param .u32 tid_in
)
{
	.reg .pred 	%p<4>;
	.reg .b32 	%r<16>;
	.reg .b64 	%rd<12>;

	ld.param.u64 	%rd1, [out];
	ld.param.u32 	%r1, [tid_in];
	mov.u64 	%rd2, temp;
	mul.wide.u32 	%rd3, %r1, 4;
	add.s64 	%rd4, %rd2, %rd3;
	ld.shared.u32 	%r2, [%rd4];
	and.b32 	%r3, %r1, 31;
	shl.b32 	%r4, %r1, 1;
	sub.s32 	%r5, %r4, %r3;
	mul.wide.u32 	%rd5, %r5, 4;
	add.s64 	%rd6, %rd2, %rd5;
	mov.u32 	%r6, 0;
	bar.sync 	0;
	setp.lt.u32 	%p2, %r1, 32;
	@!%p2 bra 	BB_DELAY_DONE;
	mov.u32 	%r14, %r1;
	mov.u32 	%r15, 0;
BB_DELAY:
	mad.lo.u32 	%r14, %r14, 1664525, 1013904223;
	add.u32 	%r15, %r15, 1;
	setp.lt.u32 	%p3, %r15, 20000;
	@%p3 bra 	BB_DELAY;
	st.volatile.shared.u32 	[%rd2+4096], %r14;
BB_DELAY_DONE:
	st.volatile.shared.u32 	[%rd6], %r6;
	st.volatile.shared.u32 	[%rd6+128], %r2;
	ld.volatile.shared.u32 	%r7, [%rd6+124];
	ld.volatile.shared.u32 	%r8, [%rd6+128];
	add.s32 	%r9, %r7, %r8;
	st.volatile.shared.u32 	[%rd6+128], %r9;
	ld.volatile.shared.u32 	%r10, [%rd6+124];
	setp.ne.s32 	%p1, %r3, 31;
	@%p1 bra 	BB_TOTALS_DONE;
	shr.u32 	%r11, %r1, 5;
	mul.wide.u32 	%rd7, %r11, 4;
	add.s64 	%rd8, %rd2, %rd7;
	add.s32 	%r12, %r10, %r2;
	st.shared.u32 	[%rd8], %r12;
BB_TOTALS_DONE:
	bar.sync 	0;
	ld.shared.u32 	%r13, [%rd4];
	st.global.u32 	[%rd1], %r13;
	ret;
}
