// Excerpt of CUB 1.0.2 RadixSortDownsweepKernel (PhysX GFSDK_DebrisRelease module, PTX
// lines 12644-12970), two items per thread: ScatterKeys writes the exchange buffer by
// rank, synchronizes and reads it back striped, then GatherScatterValues stages the
// values through the same temp_storage union with no barrier in between.
.version 6.5
.target sm_30
.address_size 64

.shared .align 4 .b8 temp_storage[8864];

.visible .entry downsweep_value_staging(
	.param .u64 keys_out,
	.param .u64 values_in,
	.param .u32 tid_in,
	.param .u32 rank0,
	.param .u32 rank1
)
{
	.reg .b32 	%r<24>;
	.reg .b64 	%rd<24>;

	ld.param.u64 	%rd1, [keys_out];
	ld.param.u64 	%rd2, [values_in];
	ld.param.u32 	%r1, [tid_in];
	ld.param.u32 	%r2, [rank0];
	ld.param.u32 	%r3, [rank1];
	mov.u64 	%rd3, temp_storage;
	mul.wide.u32 	%rd4, %r1, 4;
	add.s64 	%rd5, %rd3, %rd4;
	and.b32 	%r4, %r1, 31;
	shr.u32 	%r5, %r1, 5;
	mul.lo.s32 	%r6, %r5, 416;
	add.s32 	%r7, %r6, %r4;
	mul.wide.s32 	%rd6, %r7, 4;
	add.s64 	%rd7, %rd3, %rd6;
	mad.lo.s32 	%r8, %r4, 13, %r6;
	mul.wide.s32 	%rd8, %r8, 4;
	add.s64 	%rd9, %rd3, %rd8;
	mul.wide.u32 	%rd10, %r2, 4;
	add.s64 	%rd11, %rd3, %rd10;
	mul.wide.u32 	%rd12, %r3, 4;
	add.s64 	%rd13, %rd3, %rd12;
	ld.global.u32 	%r9, [%rd1];
	ld.global.u32 	%r10, [%rd1+4];
	st.shared.u32 	[%rd11+136], %r9;
	st.shared.u32 	[%rd13+136], %r10;
	bar.sync 	0;
	ld.shared.u32 	%r11, [%rd5+136];
	ld.shared.u32 	%r12, [%rd5+648];
	bfe.u32 	%r13, %r11, 16, 5;
	mul.wide.u32 	%rd14, %r13, 4;
	add.s64 	%rd15, %rd3, %rd14;
	ld.shared.u32 	%r14, [%rd15];
	add.s32 	%r15, %r1, %r14;
	mul.wide.s32 	%rd16, %r15, 4;
	add.s64 	%rd17, %rd1, %rd16;
	st.global.u32 	[%rd17], %r11;
	st.global.u32 	[%rd17+512], %r12;
	ld.global.u32 	%r16, [%rd2];
	ld.global.u32 	%r17, [%rd2+128];
	st.shared.u32 	[%rd7+136], %r16;
	st.shared.u32 	[%rd7+264], %r17;
	ld.shared.u32 	%r18, [%rd9+136];
	ld.shared.u32 	%r19, [%rd9+140];
	bar.sync 	0;
	st.shared.u32 	[%rd11+136], %r18;
	st.shared.u32 	[%rd13+136], %r19;
	bar.sync 	0;
	ret;
}
